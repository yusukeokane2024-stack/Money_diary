rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function memberDoc(b, u) { return /databases/$(db)/documents/books/$(b)/members/$(u); }
    function isMember(b) { return signedIn() && exists(memberDoc(b, request.auth.uid)); }
    function isOwner(b) { return isMember(b) && get(memberDoc(b, request.auth.uid)).data.role == 'owner'; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optText(v, max) { return v is string && v.size() <= max; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isType(v) { return v == 'expense' || v == 'income'; }
    function optId(v) { return v == null || (v is string && v.size() > 0 && v.size() <= 40); }
    function money(v) { return v is int && v >= 1 && v <= 999999999; }

    // ---- 自分が参加している家計簿の一覧 (本人のみ。権限の根拠は books/*/members) ----
    match /users/{uid}/memberships/{b} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role'])
        && text(request.resource.data.name, 60)
        && request.resource.data.role in ['owner', 'member'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- 家計簿 ----
    match /books/{b} {
      allow get: if isMember(b);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && text(request.resource.data.name, 60);
      allow update: if isOwner(b)
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && text(request.resource.data.name, 60);

      // メンバー: オーナー作成 (家計簿と同時) か、有効な招待コードでの本人参加のみ
      match /members/{u} {
        allow read: if isMember(b);
        allow create: if signedIn() && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['role', 'name', 'code'])
          && text(request.resource.data.name, 40)
          && (
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(db)/documents/books/$(b)).data.ownerId == u)
            ||
            (request.resource.data.role == 'member'
              && text(request.resource.data.code, 40)
              && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.bookId == b
              && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.expiresAt > request.time)
          );
        allow delete: if resource.data.role != 'owner'
          && (isOwner(b) || (signedIn() && request.auth.uid == u));
      }

      match /categories/{id} {
        allow read: if isMember(b);
        allow create, update: if isMember(b)
          && request.resource.data.keys().hasOnly(['name', 'type', 'icon', 'color', 'parentId', 'sort', 'archived'])
          && text(request.resource.data.name, 40)
          && isType(request.resource.data.type)
          && text(request.resource.data.icon, 16)
          && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
          && optId(request.resource.data.parentId)
          && request.resource.data.sort is int
          && request.resource.data.archived is bool;
        allow delete: if isMember(b);
      }

      match /transactions/{id} {
        allow read: if isMember(b);
        allow create, update: if isMember(b)
          && request.resource.data.keys().hasOnly(['userId', 'type', 'amount', 'categoryId', 'date', 'memo', 'recurringId', 'createdAt'])
          && isType(request.resource.data.type)
          && money(request.resource.data.amount)
          && isDate(request.resource.data.date)
          && optText(request.resource.data.memo, 200)
          && optId(request.resource.data.categoryId)
          && optId(request.resource.data.recurringId)
          && request.resource.data.userId is string
          && (request.method == 'create'
              ? (request.resource.data.userId == request.auth.uid || request.resource.data.recurringId != null)
              : request.resource.data.userId == resource.data.userId);
        allow delete: if isMember(b);
      }

      match /recurrings/{id} {
        allow read: if isMember(b);
        allow create, update: if isMember(b)
          && request.resource.data.keys().hasOnly(['userId', 'type', 'amount', 'categoryId', 'memo', 'freq', 'every', 'startDate', 'endDate', 'nextN', 'active'])
          && isType(request.resource.data.type)
          && money(request.resource.data.amount)
          && optId(request.resource.data.categoryId)
          && optText(request.resource.data.memo, 200)
          && request.resource.data.freq in ['daily', 'weekly', 'monthly', 'yearly']
          && request.resource.data.every is int && request.resource.data.every >= 1 && request.resource.data.every <= 365
          && isDate(request.resource.data.startDate)
          && (request.resource.data.endDate == null || isDate(request.resource.data.endDate))
          && request.resource.data.nextN is int && request.resource.data.nextN >= 0
          && request.resource.data.active is bool
          && request.resource.data.userId is string;
        allow delete: if isMember(b);
      }
    }

    // ---- 招待コード: コードを知っている人だけが1件取得できる (一覧は不可) ----
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookId', 'bookName', 'expiresAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && text(request.resource.data.bookName, 60)
        && isMember(request.resource.data.bookId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if isMember(resource.data.bookId);
    }
  }
}
